{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "deny",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow"
    },
    "webfetch": "deny",
    "external_directory": "deny"
  }
}
