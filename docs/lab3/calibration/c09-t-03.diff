+import { describe, expect, it } from 'vitest';
+
+import { UK_STOPWORDS } from '../src/rag/stopwords';
+
+describe('UK_STOPWORDS', () => {
+  it('містить щонайменше 10 службових слів', () => {
+    expect(UK_STOPWORDS.size).toBeGreaterThanOrEqual(10);
+  });
+
+  it.each(['що', 'на', 'для'])('містить слово «%s»', (word) => {
+    expect(UK_STOPWORDS.has(word)).toBe(true);
+  });
+});
