+import { describe, expect, it } from 'vitest';
+
+import { median } from '../src/metrics';
+
+describe('median', () => {
+  it('повертає центральне значення для непарної довжини', () => {
+    expect(median([3, 1, 2])).toBe(2);
+    expect(median([7])).toBe(7);
+  });
+
+  it('повертає середнє двох центральних значень для парної довжини', () => {
+    expect(median([4, 1, 3, 2])).toBe(2.5);
+    expect(median([10, 20])).toBe(15);
+  });
+
+  it('не змінює вхідний масив', () => {
+    const values = [3, 1, 2];
+    median(values);
+    expect(values).toEqual([3, 1, 2]);
+  });
+
+  it('кидає RangeError для порожнього масиву', () => {
+    expect(() => median([])).toThrow(RangeError);
+  });
+});
