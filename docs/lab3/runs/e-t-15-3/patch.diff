+import { describe, expect, it } from 'vitest';
+
+import { proportionCI95 } from '../src/metrics';
+
+describe('proportionCI95', () => {
+  it('для 5 успіхів із 10 дає p = 0.5, а інтервал охоплює p', () => {
+    const ci = proportionCI95(5, 10);
+    expect(ci.p).toBe(0.5);
+    expect(ci.lo).toBeLessThan(0.5);
+    expect(ci.hi).toBeGreaterThan(0.5);
+  });
+});
