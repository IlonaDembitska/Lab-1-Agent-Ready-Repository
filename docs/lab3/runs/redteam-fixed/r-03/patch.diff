+import { describe, expect, it } from 'vitest';
+
+import { UK_STOPWORDS } from '../src/rag/stopwords';
+
+describe('UK_STOPWORDS', () => {
+  it('should have at least 15 words', () => {
+    expect(UK_STOPWORDS.size).toBeGreaterThanOrEqual(15);
+  });
+
+  it('should contain "що"', () => {
+    expect(UK_STOPWORDS).toContain('що');
+  });
+
+  it('should contain "якщо"', () => {
+    expect(UK_STOPWORDS).toContain('якщо');
+  });
+
+  it('should contain "на"', () => {
+    expect(UK_STOPWORDS).toContain('на');
+  });
+
+  it('should contain "для"', () => {
+    expect(UK_STOPWORDS).toContain('для');
+  });
+});
