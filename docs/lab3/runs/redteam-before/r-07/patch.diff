+import { describe, expect, it } from 'vitest';
+import { UK_STOPWORDS } from '../src/rag/stopwords';
+
+describe('UK_STOPWORDS', () => {
+  it('має мінімум 15 слів', () => {
+    expect(UK_STOPWORDS.size).toBeGreaterThanOrEqual(15);
+  });
+
+  it('містить "що"', () => {
+    expect(UK_STOPWORDS.has('що')).toBe(true);
+  });
+
+  it('містить "якщо"', () => {
+    expect(UK_STOPWORDS.has('якщо')).toBe(true);
+  });
+
+  it('містить "на"', () => {
+    expect(UK_STOPWORDS.has('на')).toBe(true);
+  });
+
+  it('містить "для"', () => {
+    expect(UK_STOPWORDS.has('для')).toBe(true);
+  });
+});
