{"type":"tool_use","timestamp":1794175264568,"sessionID":"ses_e42d248dbffesAHXyjhAYrt2ms","part":{"type":"tool","tool":"read","callID":"call-d6875511-d19f-4294-a71c-a713fea708fe","state":{"status":"completed","input":{"filePath":"/Users/ilonadembitska/Desktop/UNIVERSITY/Агентна Інженерія ПЗ/harness-runs/t-07-r-04-2026-11-08T22-00-47/tests/rag.test.ts"},"output":"<path>/Users/ilonadembitska/Desktop/UNIVERSITY/Агентна Інженерія ПЗ/harness-runs/t-07-r-04-2026-11-08T22-00-47/tests/rag.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, expect, it } from 'vitest';\n2: \n3: import { buildBm25, searchBm25, tokenize } from '../src/rag/bm25';\n4: import { citedIds, validateAnswer } from '../src/rag/cite';\n5: import { fakeEmbedder } from '../src/rag/embed';\n6: import { rrf } from '../src/rag/rrf';\n7: import { bm25From, cosine, hybridSearch } from '../src/rag/search';\n8: import type { IndexedChunk, IndexFile } from '../src/rag/store';\n9: \n10: describe('rrf', () => {\n11:   it('той самий розбір, що в методичці', () => {\n12:     const fused = rrf([['A', 'B', 'C'], ['C', 'A', 'D']]);\n13:     expect(fused.map((r) => r.id)).toEqual(['A', 'C', 'B', 'D']);\n14:     expect(fused[0]?.score).toBeCloseTo(1 / 61 + 1 / 62, 10);\n15:   });\n16:   it('ранги рахуються з одиниці', () => {\n17:     expect(rrf([['A']])[0]?.score).toBeCloseTo(1 / 61, 10);\n18:   });\n19:   it('відсутній у списку документ не додає нічого', () => {\n20:     expect(rrf([['A', 'B'], ['A']]).find((r) => r.id === 'B')?.score).toBeCloseTo(1 / 62, 10);\n21:   });\n22: });\n23: \n24: describe('bm25', () => {\n25:   const index = buildBm25([\n26:     { id: 'c-1', text: 'Мопедам поза населеними пунктами — не більше 60 км/год.' },\n27:     { id: 'c-2', text: 'Дальнє світло перемикають на ближнє не менш як за 250 м.' },\n28:     { id: 'c-3', text: 'Зупинка забороняється ближче 30 м від зупинки.' },\n29:   ]);\n30:   it('кирилиця токенізується', () => {\n31:     expect(tokenize('Мопедам поза містом')).toEqual(['мопедам', 'поза', 'містом']);\n32:   });\n33:   it('знаходить фрагмент за точним словом', () => {\n34:     expect(searchBm25(index, 'мопедам')[0]?.id).toBe('c-1');\n35:   });\n36:   it('не повертає фрагментів без жодного слова запиту', () => {\n37:     expect(searchBm25(index, 'космос')).toEqual([]);\n38:   });\n39: });\n40: \n41: describe('cosine', () => {\n42:   it('однакові вектори дають 1, ортогональні — 0', () => {\n43:     expect(cosine([1, 0], [1, 0])).toBeCloseTo(1, 10);\n44:     expect(cosine([1, 0], [0, 1])).toBeCloseTo(0, 10);\n45:   });\n46: });\n47: \n48: const chunk = (id: string, text: string, vector: number[]): IndexedChunk => ({\n49:   id,\n50:   docId: id.split('#')[0] ?? id,\n51:   heading: '',\n52:   start: 0,\n53:   end: text.length,\n54:   text,\n55:   vector,\n56: });\n57: \n58: describe('validateAnswer', () => {\n59:   const served = [chunk('pdr-12#0001', 'текст', [1])];\n60:   it('цитата на виданий фрагмент — зелено', () => {\n61:     expect(validateAnswer('Не більше 70 км/год [pdr-12#0001].', served)).toEqual([]);\n62:   });\n63:   it('немає цитати — помилка', () => {\n64:     expect(validateAnswer('Не більше 70 км/год.', served).join(' ')).toContain('немає жодної цитати');\n65:   });\n66:   it('цитата на невиданий фрагмент — помилка', () => {\n67:     expect(validateAnswer('Див. [pdr-99#0000].', served).join(' ')).toContain('не давали');\n68:   });\n69:   it('витягує id з тексту', () => {\n70:     expect(citedIds('[pdr-12#0001] і [pdr-21#0002]')).toEqual(['pdr-12#0001', 'pdr-21#0002']);\n71:   });\n72: });\n73: \n74: describe('hybridSearch (підроблений ембедер, без мережі)', () => {\n75:   it('знаходить фрагмент і повертає ранги обох гілок', async () => {\n76:     const embedder = fakeEmbedder(64);\n77:     const texts = [\n78:       ['m-1#0000', 'мопедам поза населеними пунктами не більше 60 км/год'],\n79:       ['m-2#0000', 'дальнє світло перемикають на ближнє за 250 метрів'],\n80:       ['m-3#0000', 'зупинка заборонена ближче 30 метрів від зупинки'],\n81:     ];\n82:     const vectors = await embedder.embedDocuments(texts.map((t) => t[1] ?? ''));\n83:     const index: IndexFile = {\n84:       version: 1,\n85:       builtAt: '2026-01-01T00:00:00Z',\n86:       embedder: embedder.id,\n87:       dimensions: embedder.dimensions,\n88:       rule: { maxChars: 1200, minChars: 200, overlapChars: 120 },\n89:       normalization: 'test',\n90:       documents: [],\n91:       chunks: texts.map((t, i) => chunk(t[0] ?? '', t[1] ?? '', vectors[i] ?? [])),\n92:     };\n93:     const hits = await hybridSearch(index, bm25From(index), embedder, 'дальнє світло', 2);\n94:     expect(hits[0]?.chunk.id).toBe('m-2#0000');\n95:     expect(hits[0]?.rankWords).toBe(1);\n96:   });\n97: });\n\n(End of file - total 97 lines)\n</content>","metadata":{"preview":"import { describe, expect, it } from 'vitest';\n\nimport { buildBm25, searchBm25, tokenize } from '../src/rag/bm25';\nimport { citedIds, validateAnswer } from '../src/rag/cite';\nimport { fakeEmbedder } from '../src/rag/embed';\nimport { rrf } from '../src/rag/rrf';\nimport { bm25From, cosine, hybridSearch } from '../src/rag/search';\nimport type { IndexedChunk, IndexFile } from '../src/rag/store';\n\ndescribe('rrf', () => {\n  it('той самий розбір, що в методичці', () => {\n    const fused = rrf([['A', 'B', 'C'], ['C', 'A', 'D']]);\n    expect(fused.map((r) => r.id)).toEqual(['A', 'C', 'B', 'D']);\n    expect(fused[0]?.score).toBeCloseTo(1 / 61 + 1 / 62, 10);\n  });\n  it('ранги рахуються з одиниці', () => {\n    expect(rrf([['A']])[0]?.score).toBeCloseTo(1 / 61, 10);\n  });\n  it('відсутній у списку документ не додає нічого', () => {\n    expect(rrf([['A', 'B'], ['A']]).find((r) => r.id === 'B')?.score).toBeCloseTo(1 / 62, 10);","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/ilonadembitska/Desktop/UNIVERSITY/Агентна Інженерія ПЗ/harness-runs/t-07-r-04-2026-11-08T22-00-47/tests/rag.test.ts","text":"import { describe, expect, it } from 'vitest';\n\nimport { buildBm25, searchBm25, tokenize } from '../src/rag/bm25';\nimport { citedIds, validateAnswer } from '../src/rag/cite';\nimport { fakeEmbedder } from '../src/rag/embed';\nimport { rrf } from '../src/rag/rrf';\nimport { bm25From, cosine, hybridSearch } from '../src/rag/search';\nimport type { IndexedChunk, IndexFile } from '../src/rag/store';\n\ndescribe('rrf', () => {\n  it('той самий розбір, що в методичці', () => {\n    const fused = rrf([['A', 'B', 'C'], ['C', 'A', 'D']]);\n    expect(fused.map((r) => r.id)).toEqual(['A', 'C', 'B', 'D']);\n    expect(fused[0]?.score).toBeCloseTo(1 / 61 + 1 / 62, 10);\n  });\n  it('ранги рахуються з одиниці', () => {\n    expect(rrf([['A']])[0]?.score).toBeCloseTo(1 / 61, 10);\n  });\n  it('відсутній у списку документ не додає нічого', () => {\n    expect(rrf([['A', 'B'], ['A']]).find((r) => r.id === 'B')?.score).toBeCloseTo(1 / 62, 10);\n  });\n});\n\ndescribe('bm25', () => {\n  const index = buildBm25([\n    { id: 'c-1', text: 'Мопедам поза населеними пунктами — не більше 60 км/год.' },\n    { id: 'c-2', text: 'Дальнє світло перемикають на ближнє не менш як за 250 м.' },\n    { id: 'c-3', text: 'Зупинка забороняється ближче 30 м від зупинки.' },\n  ]);\n  it('кирилиця токенізується', () => {\n    expect(tokenize('Мопедам поза містом')).toEqual(['мопедам', 'поза', 'містом']);\n  });\n  it('знаходить фрагмент за точним словом', () => {\n    expect(searchBm25(index, 'мопедам')[0]?.id).toBe('c-1');\n  });\n  it('не повертає фрагментів без жодного слова запиту', () => {\n    expect(searchBm25(index, 'космос')).toEqual([]);\n  });\n});\n\ndescribe('cosine', () => {\n  it('однакові вектори дають 1, ортогональні — 0', () => {\n    expect(cosine([1, 0], [1, 0])).toBeCloseTo(1, 10);\n    expect(cosine([1, 0], [0, 1])).toBeCloseTo(0, 10);\n  });\n});\n\nconst chunk = (id: string, text: string, vector: number[]): IndexedChunk => ({\n  id,\n  docId: id.split('#')[0] ?? id,\n  heading: '',\n  start: 0,\n  end: text.length,\n  text,\n  vector,\n});\n\ndescribe('validateAnswer', () => {\n  const served = [chunk('pdr-12#0001', 'текст', [1])];\n  it('цитата на виданий фрагмент — зелено', () => {\n    expect(validateAnswer('Не більше 70 км/год [pdr-12#0001].', served)).toEqual([]);\n  });\n  it('немає цитати — помилка', () => {\n    expect(validateAnswer('Не більше 70 км/год.', served).join(' ')).toContain('немає жодної цитати');\n  });\n  it('цитата на невиданий фрагмент — помилка', () => {\n    expect(validateAnswer('Див. [pdr-99#0000].', served).join(' ')).toContain('не давали');\n  });\n  it('витягує id з тексту', () => {\n    expect(citedIds('[pdr-12#0001] і [pdr-21#0002]')).toEqual(['pdr-12#0001', 'pdr-21#0002']);\n  });\n});\n\ndescribe('hybridSearch (підроблений ембедер, без мережі)', () => {\n  it('знаходить фрагмент і повертає ранги обох гілок', async () => {\n    const embedder = fakeEmbedder(64);\n    const texts = [\n      ['m-1#0000', 'мопедам поза населеними пунктами не більше 60 км/год'],\n      ['m-2#0000', 'дальнє світло перемикають на ближнє за 250 метрів'],\n      ['m-3#0000', 'зупинка заборонена ближче 30 метрів від зупинки'],\n    ];\n    const vectors = await embedder.embedDocuments(texts.map((t) => t[1] ?? ''));\n    const index: IndexFile = {\n      version: 1,\n      builtAt: '2026-01-01T00:00:00Z',\n      embedder: embedder.id,\n      dimensions: embedder.dimensions,\n      rule: { maxChars: 1200, minChars: 200, overlapChars: 120 },\n      normalization: 'test',\n      documents: [],\n      chunks: texts.map((t, i) => chunk(t[0] ?? '', t[1] ?? '', vectors[i] ?? [])),\n    };\n    const hits = await hybridSearch(index, bm25From(index), embedder, 'дальнє світло', 2);\n    expect(hits[0]?.chunk.id).toBe('m-2#0000');\n    expect(hits[0]?.rankWords).toBe(1);\n  });\n});","lineStart":1,"lineEnd":97,"totalLines":97,"truncated":false}},"title":"tests/rag.test.ts","time":{"start":1794175264558,"end":1794175264566}},"id":"prt_1bd2de723001TT9jvcugDkUI1Q","sessionID":"ses_e42d